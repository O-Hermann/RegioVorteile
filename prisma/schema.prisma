// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYER
}

// Plattformweite Rolle (Effivo-interne Plattformverwaltung) - unabhaengig von
// der Unternehmensrolle in CompanyMembership. Optional: die meisten Nutzer
// haben keine Plattformrolle und sehen nur ihre Unternehmensbereiche.
enum PlatformRole {
  SUPERADMIN
  PLATFORM_ADMIN
  SUPPORT
}

// Rolle eines Nutzers innerhalb eines konkreten Unternehmens (CompanyMembership).
enum CompanyRole {
  OWNER
  COMPANY_ADMIN
  ACCOUNTING
  MANAGEMENT
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  DISABLED
}

enum EmployeeStatus {
  INVITED
  ACTIVE
}

enum FeedbackCategory {
  SUGGESTION
  BUG
  OTHER
  HELP
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum LegalPageSlug {
  IMPRESSUM
  DATENSCHUTZ
}

enum PartnerInquiryStatus {
  OPEN
  DONE
}

enum ContactRequestStatus {
  OPEN
  DONE
}

// Fachliche Kategorie eines Datenimports - dient in Phase 3 nur der
// Strukturierung/spaeteren Verarbeitung, noch keiner fachlichen Auswertung.
enum DataImportCategory {
  FINANCE
  ORDERS
  CUSTOMERS
}

// READY_FOR_MAPPING ist der einzige Status, der in Phase 3 tatsaechlich
// automatisch vergeben wird (nach erfolgreicher technischer Speicherung).
// Die uebrigen Werte sind bewusst fuer Phase 4/5 vorbereitet, damit dafuer
// keine erneute Migration noetig ist.
enum DataImportStatus {
  READY_FOR_MAPPING
  VALIDATION_FAILED
  READY_FOR_PROCESSING
  PROCESSED
  FAILED
  CANCELED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  // Optional seit Einfuehrung des Company/Membership-Modells: neu eingeladene
  // Nutzer werden als Stub ohne Passwort angelegt (analog Employee.passwordHash)
  // und setzen ihr Passwort erst beim Einloesen der Einladung.
  passwordHash String?
  // Legacy-Feld aus der Regiovorteile-Zeit (ADMIN/EMPLOYER) - wird von neuem
  // Code nicht mehr gelesen, bleibt nur fuer die alten Login-Formulare bestehen.
  role         UserRole?
  firstName    String?
  lastName     String?
  platformRole PlatformRole?
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())

  employer             Employer?
  passwordResetTokens  PasswordResetToken[]
  memberships          CompanyMembership[]  @relation("MemberUser")
  sentInvitations      CompanyMembership[]  @relation("InvitedByUser")
  submittedFeedback    Feedback[]           @relation("FeedbackSubmittedByUser")
  uploadedDataImports  DataImport[]         @relation("DataImportUploadedByUser")
  processedDataImports DataImport[]         @relation("DataImportProcessedByUser")
}

model Company {
  id        String        @id @default(cuid())
  name      String
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())

  memberships                CompanyMembership[]
  feedback                   Feedback[]
  dataImports                DataImport[]
  dataImportMappings         DataImportMapping[]
  dataImportRecords          DataImportRecord[]
  dataImportMappingTemplates DataImportMappingTemplate[]
}

// Verbindet einen User mit einem Company - ein Nutzer kann Mitglied mehrerer
// Unternehmen sein, jeweils mit eigener Rolle. Ersetzt das alte 1:1-Muster
// Employer.userId fuer alle neuen (nicht-Regiovorteile) Unternehmen.
model CompanyMembership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("MemberUser", fields: [userId], references: [id])
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  role      CompanyRole
  status    MembershipStatus @default(INVITED)

  invitedAt   DateTime  @default(now())
  activatedAt DateTime?

  invitedById String?
  invitedBy   User?   @relation("InvitedByUser", fields: [invitedById], references: [id])

  // Einladungslink-Token, analog PasswordResetToken: kryptografisch zufaellig,
  // einmalig verwendbar (wird beim Einloesen genullt), zeitlich begrenzt.
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?

  @@unique([userId, companyId])
}

model Region {
  id       String @id @default(cuid())
  name     String @unique
  plzCodes String // Komma-getrennte Liste, z.B. "12345,12347,12350"

  employers Employer[]
  partners  PartnerBusiness[]

  createdAt DateTime @default(now())
}

model PricingTier {
  id                String @id @default(cuid())
  label             String
  minEmployees      Int
  maxEmployees      Int? // null = unbegrenzt
  monthlyPriceCents Int

  employers Employer[]
}

model Employer {
  id                 String      @id @default(cuid())
  companyName        String
  userId             String      @unique
  user               User        @relation(fields: [userId], references: [id])
  employeeCount      Int
  regionId           String
  region             Region      @relation(fields: [regionId], references: [id])
  pricingTierId      String
  pricingTier        PricingTier @relation(fields: [pricingTierId], references: [id])
  subscriptionStatus String      @default("ausstehend") // Platzhalter, spaeter durch echte Stripe-Subscription ersetzt
  contractEndDate    DateTime // Ende der aktuellen Vertragslaufzeit
  approved           Boolean     @default(true) // neue Registrierungen starten explizit mit false, siehe registerEmployer
  contactFirstName   String?
  contactLastName    String?
  phone              String?
  street             String?
  plz                String?
  city               String?
  createdAt          DateTime    @default(now())

  employees Employee[]
  feedback  Feedback[]
}

model Employee {
  id           String         @id @default(cuid())
  employerId   String
  employer     Employer       @relation(fields: [employerId], references: [id])
  name         String
  email        String         @unique
  passwordHash String?
  inviteCode   String         @unique
  status       EmployeeStatus @default(INVITED)
  createdAt    DateTime       @default(now())

  redemptions         Redemption[]
  feedback            Feedback[]
  passwordResetTokens PasswordResetToken[]
}

model PartnerBusiness {
  id              String   @id @default(cuid())
  name            String
  category        String
  description     String
  discountText    String
  regionId        String
  region          Region   @relation(fields: [regionId], references: [id])
  street          String // Strasse und Hausnummer
  plz             String
  city            String
  logoUrl         String?
  active          Boolean  @default(true)
  contractEndDate DateTime // Ende der Vereinbarung mit dem Partnerbetrieb

  redemptions Redemption[]
  createdAt   DateTime     @default(now())
}

model Redemption {
  id                String          @id @default(cuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])
  partnerBusinessId String
  partnerBusiness   PartnerBusiness @relation(fields: [partnerBusinessId], references: [id])
  code              String
  createdAt         DateTime        @default(now())
}

model Feedback {
  id                String           @id @default(cuid())
  subject           String? // Betreff - neu seit Company-Support, alte Zeilen bleiben null
  message           String
  category          FeedbackCategory
  status            FeedbackStatus   @default(OPEN)
  employerId        String?
  employer          Employer?        @relation(fields: [employerId], references: [id])
  employeeId        String?
  employee          Employee?        @relation(fields: [employeeId], references: [id])
  // Neues Company/User-Modell: Support-Anfragen aus dem Unternehmensbereich
  companyId         String?
  company           Company?         @relation(fields: [companyId], references: [id])
  submittedByUserId String?
  submittedByUser   User?            @relation("FeedbackSubmittedByUser", fields: [submittedByUserId], references: [id])
  createdAt         DateTime         @default(now())
}

model LegalPage {
  id        String        @id @default(cuid())
  slug      LegalPageSlug @unique
  title     String
  content   String // Freitext, Absaetze durch Leerzeile getrennt
  updatedAt DateTime      @updatedAt
}

model PartnerInquiry {
  id           String               @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String?
  message      String?
  status       PartnerInquiryStatus @default(OPEN)
  createdAt    DateTime             @default(now())
}

model ContactRequest {
  id          String               @id @default(cuid())
  firstName   String
  lastName    String
  companyName String
  street      String
  postalCode  String
  phone       String
  message     String?
  status      ContactRequestStatus @default(OPEN)
  createdAt   DateTime             @default(now())
}

// Phase 3: technischer Datenimport (Datei-Upload, Vorschau, Speicherung).
// Enthaelt bewusst noch keine fachliche Zuordnung/Auswertung - das ist
// Phase 4/5. Kein persistenter Object Storage im Projekt vorhanden, daher
// wird die Datei fuer dieses fruehe MVP direkt als Bytes in Postgres
// gespeichert (siehe Abschlussbericht zur Speicherstrategie).
model DataImport {
  id               String  @id @default(cuid())
  companyId        String
  company          Company @relation(fields: [companyId], references: [id])
  uploadedByUserId String
  uploadedByUser   User    @relation("DataImportUploadedByUser", fields: [uploadedByUserId], references: [id])

  periodMonth Int // 1-12
  periodYear  Int

  category     DataImportCategory
  sourceSystem String? // normalisierter Freitext (z.B. "DATEV"), bewusst kein Enum

  fileName    String
  fileType    String // "xlsx" | "xls" | "csv"
  mimeType    String
  fileSize    Int
  fileContent Bytes

  selectedSheetName String? // nur bei Excel mit mehreren Tabellenblaettern relevant
  sheetNames        String[] // alle erkannten Tabellenblaetter (Excel), leer bei CSV

  checksumSha256 String // fuer Duplikaterkennung je Unternehmen

  rowCount    Int?
  columnCount Int?

  status       DataImportStatus @default(READY_FOR_MAPPING)
  errorMessage String?

  // Phase 4: Verarbeitungsmetadaten. processedAt/processedByUser werden nur
  // bei erfolgreichem Abschluss (Status PROCESSED) gesetzt.
  processedAt       DateTime?
  processedByUserId String?
  processedByUser   User?     @relation("DataImportProcessedByUser", fields: [processedByUserId], references: [id])
  processedRowCount Int?
  mappedColumnCount Int?

  mapping DataImportMapping?
  records DataImportRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, checksumSha256])
}

// Phase 4: Spaltenzuordnung eines konkreten Datenimports - immer eindeutig an
// genau einen DataImport gebunden (1:1), zusaetzlich companyId denormalisiert
// fuer direkte, redundante Mandanten-Filterung in jeder Abfrage (defense in
// depth, auch wenn dataImportId allein bereits eindeutig ist). "columns" haelt
// die vollstaendige Zuordnung als JSON-Array (siehe MappingColumnDef in
// src/lib/import-fields.ts): { index, sourceName, targetField }, wobei
// targetField entweder ein Feldschluessel, "__ignore__" (bewusst ignoriert)
// oder null (noch nicht entschieden) ist. Ein Import kann so verlassen und
// spaeter fortgesetzt werden, ohne dass eine unvollstaendige Zuordnung
// verloren geht.
model DataImportMapping {
  id           String     @id @default(cuid())
  dataImportId String     @unique
  dataImport   DataImport @relation(fields: [dataImportId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])

  columns Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Phase 4: wiederverwendbare Mapping-Vorlage. Wird nach erfolgreicher
// Verarbeitung automatisch aus der bestaetigten Zuordnung abgeleitet (siehe
// actions/data-import-mapping.ts) und bei einem spaeteren Import gleicher
// Kategorie anhand einer normalisierten, sortierten Spalten-Signatur wieder
// vorgeschlagen - NICHT anhand des Dateinamens. sourceSystem wird nur
// informativ mitgespeichert (kein hartes Kriterium), columnSignature ist das
// eigentliche Wiedererkennungsmerkmal.
model DataImportMappingTemplate {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id])
  category        DataImportCategory
  sourceSystem    String?
  columnSignature String

  columns Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, category, columnSignature])
  @@index([companyId])
}

// Phase 4: normalisierte Zeilendaten nach erfolgreicher Verarbeitung -
// bewusst EINE Zeile pro Datensatz der Quelldatei (nicht z.B. eine Zeile pro
// Zelle), da Phase 5 zuverlaessig ueber Betraege/Status/Zeitraeume aggregieren
// koennen muss. Die Zeilenzahl ist durch das bestehende MAX_IMPORT_ROWS-Limit
// (50.000) ohnehin begrenzt und fuer typische KMU-Monatsimporte um
// Groessenordnungen kleiner - siehe Abschlussbericht zur Begruendung dieser
// Speicherstrategie. Generische Spaltennamen (statt z.B. "rechnungsnummer"),
// da dieselbe Struktur fuer FINANCE/ORDERS/CUSTOMERS verwendet wird (siehe
// storageColumn-Zuordnung in src/lib/import-fields.ts) - pro Kategorie bleibt
// jede Spalte eindeutig einem Zielfeld zugeordnet, keine Kollisionen.
model DataImportRecord {
  id           String     @id @default(cuid())
  dataImportId String
  dataImport   DataImport @relation(fields: [dataImportId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  rowNumber    Int // 1-basierte Zeilennummer in der Quelldatei (ohne Kopfzeile), fuer Nachvollziehbarkeit

  referenceNumber String?
  primaryDate     DateTime?
  name            String?
  organization    String?
  description     String?
  dueDate         DateTime?
  completionDate  DateTime?
  bookingDate     DateTime?

  status    String? // normalisierter interner Status (PAID/OPEN/PARTIALLY_PAID/OVERDUE/CANCELED)
  statusRaw String? // unveraenderter Rohwert aus der Datei

  netAmount   Decimal? @db.Decimal(14, 2)
  taxAmount   Decimal? @db.Decimal(14, 2)
  grossAmount Decimal? @db.Decimal(14, 2)
  costAmount  Decimal? @db.Decimal(14, 2)
  openAmount  Decimal? @db.Decimal(14, 2)
  amount      Decimal? @db.Decimal(14, 2)

  accountNumber String?
  accountLabel  String?
  metricLabel   String?
  responsible   String?
  email         String?
  phone         String?

  createdAt DateTime @default(now())

  @@index([dataImportId])
  @@index([companyId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}
