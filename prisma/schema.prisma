// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYER
}

// Plattformweite Rolle (Effivo-interne Plattformverwaltung) - unabhaengig von
// der Unternehmensrolle in CompanyMembership. Optional: die meisten Nutzer
// haben keine Plattformrolle und sehen nur ihre Unternehmensbereiche.
enum PlatformRole {
  SUPERADMIN
  PLATFORM_ADMIN
  SUPPORT
}

// Rolle eines Nutzers innerhalb eines konkreten Unternehmens (CompanyMembership).
enum CompanyRole {
  OWNER
  COMPANY_ADMIN
  ACCOUNTING
  MANAGEMENT
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  DISABLED
}

enum EmployeeStatus {
  INVITED
  ACTIVE
}

enum FeedbackCategory {
  SUGGESTION
  BUG
  OTHER
  HELP
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum LegalPageSlug {
  IMPRESSUM
  DATENSCHUTZ
}

enum PartnerInquiryStatus {
  OPEN
  DONE
}

enum ContactRequestStatus {
  OPEN
  DONE
}

// Phase 6.1: Status eines Kunden-Grundsystem-Datensatzes - bewusst nur
// ACTIVE/INACTIVE (kein Lead/Prospect/Won/Lost), da das zu einer spaeteren,
// eigenstaendigen Vertriebs-/Pipeline-Systematik gehoert.
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// Phase 6.2.1: bewusst ein kleiner, fester Satz an Status ohne Zusatzgruende
// (Punkt 3) - COMPLETED bekommt zusaetzlich ein eigenes completedAt-Feld auf
// Order, da "erledigt diesen Monat" sonst faelschlich updatedAt (jede
// Aenderung) statt des tatsaechlichen Abschlussdatums verwenden muesste.
enum OrderStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELED
}

// Fachliche Kategorie eines Datenimports - dient in Phase 3 nur der
// Strukturierung/spaeteren Verarbeitung, noch keiner fachlichen Auswertung.
enum DataImportCategory {
  FINANCE
  ORDERS
  CUSTOMERS
}

// READY_FOR_MAPPING ist der einzige Status, der in Phase 3 tatsaechlich
// automatisch vergeben wird (nach erfolgreicher technischer Speicherung).
// Die uebrigen Werte sind bewusst fuer Phase 4/5 vorbereitet, damit dafuer
// keine erneute Migration noetig ist.
enum DataImportStatus {
  READY_FOR_MAPPING
  VALIDATION_FAILED
  READY_FOR_PROCESSING
  PROCESSED
  FAILED
  CANCELED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  // Optional seit Einfuehrung des Company/Membership-Modells: neu eingeladene
  // Nutzer werden als Stub ohne Passwort angelegt (analog Employee.passwordHash)
  // und setzen ihr Passwort erst beim Einloesen der Einladung.
  passwordHash String?
  // Legacy-Feld aus der Regiovorteile-Zeit (ADMIN/EMPLOYER) - wird von neuem
  // Code nicht mehr gelesen, bleibt nur fuer die alten Login-Formulare bestehen.
  role         UserRole?
  firstName    String?
  lastName     String?
  platformRole PlatformRole?
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())

  employer             Employer?
  passwordResetTokens  PasswordResetToken[]
  memberships          CompanyMembership[]  @relation("MemberUser")
  sentInvitations      CompanyMembership[]  @relation("InvitedByUser")
  submittedFeedback    Feedback[]           @relation("FeedbackSubmittedByUser")
  uploadedDataImports  DataImport[]         @relation("DataImportUploadedByUser")
  processedDataImports DataImport[]         @relation("DataImportProcessedByUser")
  createdCustomers     Customer[]           @relation("CustomerCreatedByUser")
  createdOrders        Order[]              @relation("OrderCreatedByUser")
}

model Company {
  id        String        @id @default(cuid())
  name      String
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())

  memberships                CompanyMembership[]
  feedback                   Feedback[]
  dataImports                DataImport[]
  dataImportMappings         DataImportMapping[]
  dataImportRecords          DataImportRecord[]
  dataImportMappingTemplates DataImportMappingTemplate[]
  customers                  Customer[]
  orders                     Order[]
}

// Verbindet einen User mit einem Company - ein Nutzer kann Mitglied mehrerer
// Unternehmen sein, jeweils mit eigener Rolle. Ersetzt das alte 1:1-Muster
// Employer.userId fuer alle neuen (nicht-Regiovorteile) Unternehmen.
model CompanyMembership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("MemberUser", fields: [userId], references: [id])
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  role      CompanyRole
  status    MembershipStatus @default(INVITED)

  invitedAt   DateTime  @default(now())
  activatedAt DateTime?

  invitedById String?
  invitedBy   User?   @relation("InvitedByUser", fields: [invitedById], references: [id])

  // Einladungslink-Token, analog PasswordResetToken: kryptografisch zufaellig,
  // einmalig verwendbar (wird beim Einloesen genullt), zeitlich begrenzt.
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?

  @@unique([userId, companyId])
}

model Region {
  id       String @id @default(cuid())
  name     String @unique
  plzCodes String // Komma-getrennte Liste, z.B. "12345,12347,12350"

  employers Employer[]
  partners  PartnerBusiness[]

  createdAt DateTime @default(now())
}

model PricingTier {
  id                String @id @default(cuid())
  label             String
  minEmployees      Int
  maxEmployees      Int? // null = unbegrenzt
  monthlyPriceCents Int

  employers Employer[]
}

model Employer {
  id                 String      @id @default(cuid())
  companyName        String
  userId             String      @unique
  user               User        @relation(fields: [userId], references: [id])
  employeeCount      Int
  regionId           String
  region             Region      @relation(fields: [regionId], references: [id])
  pricingTierId      String
  pricingTier        PricingTier @relation(fields: [pricingTierId], references: [id])
  subscriptionStatus String      @default("ausstehend") // Platzhalter, spaeter durch echte Stripe-Subscription ersetzt
  contractEndDate    DateTime // Ende der aktuellen Vertragslaufzeit
  approved           Boolean     @default(true) // neue Registrierungen starten explizit mit false, siehe registerEmployer
  contactFirstName   String?
  contactLastName    String?
  phone              String?
  street             String?
  plz                String?
  city               String?
  createdAt          DateTime    @default(now())

  employees Employee[]
  feedback  Feedback[]
}

model Employee {
  id           String         @id @default(cuid())
  employerId   String
  employer     Employer       @relation(fields: [employerId], references: [id])
  name         String
  email        String         @unique
  passwordHash String?
  inviteCode   String         @unique
  status       EmployeeStatus @default(INVITED)
  createdAt    DateTime       @default(now())

  redemptions         Redemption[]
  feedback            Feedback[]
  passwordResetTokens PasswordResetToken[]
}

model PartnerBusiness {
  id              String   @id @default(cuid())
  name            String
  category        String
  description     String
  discountText    String
  regionId        String
  region          Region   @relation(fields: [regionId], references: [id])
  street          String // Strasse und Hausnummer
  plz             String
  city            String
  logoUrl         String?
  active          Boolean  @default(true)
  contractEndDate DateTime // Ende der Vereinbarung mit dem Partnerbetrieb

  redemptions Redemption[]
  createdAt   DateTime     @default(now())
}

model Redemption {
  id                String          @id @default(cuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])
  partnerBusinessId String
  partnerBusiness   PartnerBusiness @relation(fields: [partnerBusinessId], references: [id])
  code              String
  createdAt         DateTime        @default(now())
}

model Feedback {
  id                String           @id @default(cuid())
  subject           String? // Betreff - neu seit Company-Support, alte Zeilen bleiben null
  message           String
  category          FeedbackCategory
  status            FeedbackStatus   @default(OPEN)
  employerId        String?
  employer          Employer?        @relation(fields: [employerId], references: [id])
  employeeId        String?
  employee          Employee?        @relation(fields: [employeeId], references: [id])
  // Neues Company/User-Modell: Support-Anfragen aus dem Unternehmensbereich
  companyId         String?
  company           Company?         @relation(fields: [companyId], references: [id])
  submittedByUserId String?
  submittedByUser   User?            @relation("FeedbackSubmittedByUser", fields: [submittedByUserId], references: [id])
  createdAt         DateTime         @default(now())
}

model LegalPage {
  id        String        @id @default(cuid())
  slug      LegalPageSlug @unique
  title     String
  content   String // Freitext, Absaetze durch Leerzeile getrennt
  updatedAt DateTime      @updatedAt
}

model PartnerInquiry {
  id           String               @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String?
  message      String?
  status       PartnerInquiryStatus @default(OPEN)
  createdAt    DateTime             @default(now())
}

model ContactRequest {
  id          String               @id @default(cuid())
  firstName   String
  lastName    String
  companyName String
  street      String
  postalCode  String
  phone       String
  message     String?
  status      ContactRequestStatus @default(OPEN)
  createdAt   DateTime             @default(now())
}

// Phase 3: technischer Datenimport (Datei-Upload, Vorschau, Speicherung).
// Enthaelt bewusst noch keine fachliche Zuordnung/Auswertung - das ist
// Phase 4/5. Kein persistenter Object Storage im Projekt vorhanden, daher
// wird die Datei fuer dieses fruehe MVP direkt als Bytes in Postgres
// gespeichert (siehe Abschlussbericht zur Speicherstrategie).
model DataImport {
  id               String  @id @default(cuid())
  companyId        String
  company          Company @relation(fields: [companyId], references: [id])
  uploadedByUserId String
  uploadedByUser   User    @relation("DataImportUploadedByUser", fields: [uploadedByUserId], references: [id])

  periodMonth Int // 1-12
  periodYear  Int

  category     DataImportCategory
  sourceSystem String? // normalisierter Freitext (z.B. "DATEV"), bewusst kein Enum

  fileName    String
  fileType    String // "xlsx" | "xls" | "csv"
  mimeType    String
  fileSize    Int
  fileContent Bytes

  selectedSheetName String? // nur bei Excel mit mehreren Tabellenblaettern relevant
  sheetNames        String[] // alle erkannten Tabellenblaetter (Excel), leer bei CSV

  checksumSha256 String // fuer Duplikaterkennung je Unternehmen

  rowCount    Int?
  columnCount Int?

  status       DataImportStatus @default(READY_FOR_MAPPING)
  errorMessage String?

  // Phase 4: Verarbeitungsmetadaten. processedAt/processedByUser werden nur
  // bei erfolgreichem Abschluss (Status PROCESSED) gesetzt.
  processedAt       DateTime?
  processedByUserId String?
  processedByUser   User?     @relation("DataImportProcessedByUser", fields: [processedByUserId], references: [id])
  processedRowCount Int?
  mappedColumnCount Int?

  mapping DataImportMapping?
  records DataImportRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, checksumSha256])
}

// Phase 4: Spaltenzuordnung eines konkreten Datenimports - immer eindeutig an
// genau einen DataImport gebunden (1:1), zusaetzlich companyId denormalisiert
// fuer direkte, redundante Mandanten-Filterung in jeder Abfrage (defense in
// depth, auch wenn dataImportId allein bereits eindeutig ist). "columns" haelt
// die vollstaendige Zuordnung als JSON-Array (siehe MappingColumnDef in
// src/lib/import-fields.ts): { index, sourceName, targetField }, wobei
// targetField entweder ein Feldschluessel, "__ignore__" (bewusst ignoriert)
// oder null (noch nicht entschieden) ist. Ein Import kann so verlassen und
// spaeter fortgesetzt werden, ohne dass eine unvollstaendige Zuordnung
// verloren geht.
model DataImportMapping {
  id           String     @id @default(cuid())
  dataImportId String     @unique
  dataImport   DataImport @relation(fields: [dataImportId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])

  columns Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Phase 4: wiederverwendbare Mapping-Vorlage. Wird nach erfolgreicher
// Verarbeitung automatisch aus der bestaetigten Zuordnung abgeleitet (siehe
// actions/data-import-mapping.ts) und bei einem spaeteren Import gleicher
// Kategorie anhand einer normalisierten, sortierten Spalten-Signatur wieder
// vorgeschlagen - NICHT anhand des Dateinamens. sourceSystem wird nur
// informativ mitgespeichert (kein hartes Kriterium), columnSignature ist das
// eigentliche Wiedererkennungsmerkmal.
model DataImportMappingTemplate {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id])
  category        DataImportCategory
  sourceSystem    String?
  columnSignature String

  columns Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, category, columnSignature])
  @@index([companyId])
}

// Phase 4: normalisierte Zeilendaten nach erfolgreicher Verarbeitung -
// bewusst EINE Zeile pro Datensatz der Quelldatei (nicht z.B. eine Zeile pro
// Zelle), da Phase 5 zuverlaessig ueber Betraege/Status/Zeitraeume aggregieren
// koennen muss. Die Zeilenzahl ist durch das bestehende MAX_IMPORT_ROWS-Limit
// (50.000) ohnehin begrenzt und fuer typische KMU-Monatsimporte um
// Groessenordnungen kleiner - siehe Abschlussbericht zur Begruendung dieser
// Speicherstrategie. Generische Spaltennamen (statt z.B. "rechnungsnummer"),
// da dieselbe Struktur fuer FINANCE/ORDERS/CUSTOMERS verwendet wird (siehe
// storageColumn-Zuordnung in src/lib/import-fields.ts) - pro Kategorie bleibt
// jede Spalte eindeutig einem Zielfeld zugeordnet, keine Kollisionen.
model DataImportRecord {
  id           String     @id @default(cuid())
  dataImportId String
  dataImport   DataImport @relation(fields: [dataImportId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  rowNumber    Int // 1-basierte Zeilennummer in der Quelldatei (ohne Kopfzeile), fuer Nachvollziehbarkeit

  referenceNumber String?
  primaryDate     DateTime?
  name            String?
  organization    String?
  description     String?
  dueDate         DateTime?
  completionDate  DateTime?
  bookingDate     DateTime?

  status    String? // normalisierter interner Status (PAID/OPEN/PARTIALLY_PAID/OVERDUE/CANCELED)
  statusRaw String? // unveraenderter Rohwert aus der Datei

  // Fund-Kategorie "Offene Gutschriften" (MVP-Roadmap Phase 1.1): analog zu
  // status/statusRaw normalisiertes Feld + Rohwert, siehe import-fields.ts
  // (CanonicalDocumentType) und import-process.ts (normalizeDocumentTypeCell).
  // Nur fuer FINANCE-Importe gemappt; bei allen aelteren/anderen Zeilen bleibt
  // es null (kein "Rechnung" geraten) - normalizeDocumentTypeValue() gibt bei
  // unbekannten Rohwerten bewusst null zurueck statt zu raten.
  documentType    String? // normalisiert (INVOICE/CREDIT_NOTE)
  documentTypeRaw String? // unveraenderter Rohwert aus der Datei

  netAmount   Decimal? @db.Decimal(14, 2)
  taxAmount   Decimal? @db.Decimal(14, 2)
  grossAmount Decimal? @db.Decimal(14, 2)
  costAmount  Decimal? @db.Decimal(14, 2)
  openAmount  Decimal? @db.Decimal(14, 2)
  amount      Decimal? @db.Decimal(14, 2)
  // Fund-Kategorie "Moegliche Ueberzahlung" (MVP-Roadmap Phase 1.2): der
  // tatsaechlich gezahlte Betrag, bewusst getrennt von grossAmount/amount
  // (der Rechnungs-/Sollbetrag) - siehe overpayment-detection.ts. Ein reines
  // Zahlenfeld ohne Rohwert-Companion (anders als status/documentType), da
  // hier keine Wortschatz-Normalisierung noetig ist.
  paidAmount  Decimal? @db.Decimal(14, 2)

  accountNumber String?
  accountLabel  String?
  metricLabel   String?
  responsible   String?
  email         String?
  phone         String?

  createdAt DateTime @default(now())

  @@index([dataImportId])
  @@index([companyId])
}

// Phase 6.1: mandantenfaehiges Kunden-Grundsystem - bewusst getrennt von
// DataImportRecord (Kategorie CUSTOMERS): DataImportRecord bildet importierte
// Rohzeilen einer Datei ab, Customer ist der eigentliche, dauerhaft gepflegte
// Kundenstamm. Es gibt in Phase 6.1 bewusst NOCH KEINE automatische
// Uebernahme/Verknuepfung zwischen beiden (kein Fuzzy-Matching, siehe
// Abschlussbericht) - das ist eine spaetere, eigene Phase. companyId ist
// direkt auf Customer (nicht nur ueber eine Relation erreichbar), damit jede
// Abfrage unmittelbar mandantenscharf gefiltert werden kann (Punkt 6).
model Customer {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  customerNumber String?
  name           String
  email          String?
  phone          String?
  website        String?
  street         String?
  postalCode     String?
  city           String?
  country        String?
  notes          String?
  status         CustomerStatus @default(ACTIVE)

  createdByUserId String?
  createdByUser   User?   @relation("CustomerCreatedByUser", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts CustomerContact[]
  orders   Order[]

  // Kundennummer ist nur INNERHALB eines Unternehmens eindeutig (Punkt 24) -
  // ein anderes Unternehmen darf dieselbe Nummer vergeben. Mehrere Kunden
  // ohne Kundennummer (NULL) sind erlaubt, da Postgres NULL-Werte in einem
  // UNIQUE-Index als paarweise verschieden behandelt.
  @@unique([companyId, customerNumber])
  @@index([companyId])
}

// Phase 6.1: eigenstaendiges Modell statt nur eines einzelnen
// Ansprechpartner-Feldes auf Customer (Punkt 4) - ein Kunde kann mehrere
// Ansprechpartner haben (z.B. Geschaeftsfuehrung + Buchhaltung). firstName/
// lastName sind bewusst beide optional: bei der Kundenanlage genuegt bereits
// EIN ausgefuellter Name, um einen ersten Hauptansprechpartner anzulegen.
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  firstName String?
  lastName  String?
  position  String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// Phase 6.2.1: Grundlage der Auftragsverwaltung (Punkt 2) - ein Auftrag
// gehoert zwingend zu genau einem Unternehmen UND genau einem bereits
// angelegten Kunden. Die Kundenbeziehung ist bewusst "onDelete: Restrict"
// (kein Cascade, kein SetNull) statt des sonst ueblichen Prisma-Defaults fuer
// Pflichtbeziehungen unveraendert zu lassen: ein Kunde mit vorhandenen
// Auftraegen darf serverseitig nicht geloescht werden koennen (siehe
// deleteCustomer() in actions/customers.ts, das dies zusaetzlich VOR dem
// Loeschversuch aktiv prueft, damit der Nutzer nie eine rohe DB-Fehlermeldung
// sieht). Bewusst KEINE Verknuepfung zu DataImportRecord/Finanzdaten -
// Auftraege und importierte Finanzkennzahlen bleiben getrennte Datenquellen.
model Order {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderNumber String
  title       String
  description String?
  status      OrderStatus @default(OPEN)
  startDate   DateTime?
  dueDate     DateTime?
  // Nur bei Status COMPLETED gesetzt (Punkt 8.3) - bewusst ein eigenes Feld
  // statt updatedAt zu missbrauchen, das sich bei JEDER Aenderung mitbewegt.
  completedAt DateTime?

  createdByUserId String
  createdByUser   User   @relation("OrderCreatedByUser", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auftragsnummer ist nur INNERHALB eines Unternehmens eindeutig (Punkt 13),
  // analog zu Customer.customerNumber - zwei Unternehmen duerfen dieselbe
  // Nummer unabhaengig voneinander vergeben.
  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([customerId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}
